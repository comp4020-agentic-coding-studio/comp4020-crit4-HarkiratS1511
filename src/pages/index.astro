---
import Layout from "../layouts/Layout.astro";
import { D_KURD, fieldsFor } from "../scripts/audio/scales";
import { FIELD_KEYS, litness, placement } from "../scripts/ui/layout";

// The whole pan: the ding and its eight tone fields, in D Kurd. The field list
// comes from the same module the audio engine is built from, so the note
// stamped on the steel and the note that sounds cannot drift apart.
//
// DOM order is scale order — ding, then the eight ascending — which is also the
// order Tab visits them in. The zigzag is in the geometry, not the markup, so a
// keyboard player climbs the scale in pitch order while a pair of hands climbs
// it alternating left and right. Both are the instrument's real order.
const fields = fieldsFor(D_KURD);

// Sprint 5: the scale glides. The control for it is a groove machined into
// the outer rim, well clear of every tone field — the two lowest fields (see
// ui/layout.ts's RING_RADIUS and per-field size) reach no further than about
// 44% of the shell's radius from the centre at any angle, so an arc drawn out
// at 46% never collides with a crater regardless of where around the pan it
// runs. It sits low and centred, in front of the player, the way a maker's
// mark or a tuning detail would sit on real steel.
//
// Angles are degrees clockwise from twelve o'clock, the same convention
// ui/layout.ts uses for the fields, so "180" here means the same thing it
// means there: the near edge of the pan, closest to the player.
const TUNE_RADIUS = 46;
const TUNE_ANGLE_FROM = 130;
const TUNE_ANGLE_TO = 230;

function arcPoint(angle: number): { x: number; y: number } {
  const radians = (angle * Math.PI) / 180;
  return { x: 50 + TUNE_RADIUS * Math.sin(radians), y: 50 - TUNE_RADIUS * Math.cos(radians) };
}

/** One circular arc, as an SVG path, from the pan's own scale (t=0) to the
 *  scale it glides toward (t=1). Read left to right, matching the direction
 *  a native range input already moves in. */
function tunePath(): string {
  const start = arcPoint(TUNE_ANGLE_FROM);
  const end = arcPoint(TUNE_ANGLE_TO);
  const largeArc = Math.abs(TUNE_ANGLE_TO - TUNE_ANGLE_FROM) > 180 ? 1 : 0;
  return `M ${start.x.toFixed(3)} ${start.y.toFixed(3)} A ${TUNE_RADIUS} ${TUNE_RADIUS} 0 ${largeArc} 1 ${end.x.toFixed(3)} ${end.y.toFixed(3)}`;
}

const TUNE_PATH = tunePath();

/** Each button carries its own place on the shell, so the layout is data and
 *  the stylesheet only has to know how to draw a crater. */
function place(index: number): string {
  const { x, y, size } = placement(index);
  return [
    `--fx:${x.toFixed(3)}%`,
    `--fy:${y.toFixed(3)}%`,
    // Unitless, so every length inside the field — the depth of its shading,
    // the size of its stamp — can be a share of the field's own diameter and
    // stay in proportion from a 1920px desktop down to a 390px phone.
    `--sizen:${(size / 100).toFixed(5)}`,
    // How much light this part of the dome is turned toward, so a crater on
    // the far shoulder of the shell is dimmer than one facing the lamp.
    `--lit:${litness(index).toFixed(4)}`,
    // Position in the scale, used to stagger the waiting animation so the pan
    // breathes as one object rather than as nine.
    `--seq:${index}`,
  ].join(";");
}
---

<Layout
  title="Handpan"
  description="A handpan synthesised live in the browser: nine tone fields in D Kurd laid out the way real steel is, struck with the weight of your hand and coloured by where on the field you land."
>
  <header class="masthead">
    <h1>Handpan <span class="scale">D Kurd</span></h1>
  </header>

  <main class="stage">
    <div class="shell">
      {
        fields.map((field) => (
          <button
            class="field"
            type="button"
            data-field={field.index}
            aria-keyshortcuts={FIELD_KEYS[field.index]}
            style={place(field.index)}
          >
            <span class="face" aria-hidden="true" />
            <span class="stamp">{field.name}</span>
            <span class="cue" aria-hidden="true">
              {FIELD_KEYS[field.index]}
            </span>
          </button>
        ))
      }

      <input
        class="tune-input"
        type="range"
        min="0"
        max="1"
        step="0.001"
        value="0"
        aria-label="Drift the shell's tuning toward Celtic Minor"
        data-tune-input
      />
      <div class="tune" aria-hidden="true">
        <svg viewBox="0 0 100 100">
          <path class="tune-groove" d={TUNE_PATH} />
          <path class="tune-sheen" d={TUNE_PATH} />
          <path class="tune-fill" d={TUNE_PATH} pathLength="100" />
          <path class="tune-hit" d={TUNE_PATH} data-tune-hit />
        </svg>
      </div>
    </div>
  </main>

  <footer class="colophon">
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </footer>

  <script src="../scripts/main.ts"></script>
</Layout>
